{
  "name": "@assetgate/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "api": "tsx src/api.ts",
    "indexer": "tsx src/indexer.ts",
    "dev": "concurrently -n api,indexer -c blue,green \"npm run api\" \"npm run indexer\""
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^11.2.1",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "concurrently": "^9.0.1",
    "prisma": "7.10.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0"
  }
}
