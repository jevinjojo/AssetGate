{
  "extends": "solhint:recommended",
  "rules": {
    "compiler-version": [
      "error",
      "^0.8.17"
    ],
    "func-visibility": [
      "warn",
      {
        "ignoreConstructors": true
      }
    ],
    "not-rely-on-time": "off",
    "no-inline-assembly": "off",
    "avoid-low-level-calls": "warn",
    "reason-string": [
      "warn",
      {
        "maxLength": 64
      }
    ],
    "custom-errors": "off",
    "max-line-length": [
      "warn",
      120
    ]
  }
}